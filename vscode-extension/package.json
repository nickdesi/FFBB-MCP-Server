{
  "name": "ffbb-basketball-mcp",
  "displayName": "FFBB Basketball MCP",
  "description": "MCP server for French Basketball Federation (FFBB) — scores, standings, calendars and live data for AI agents.",
  "version": "1.2.0",
  "publisher": "nickdesi",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickdesi/FFBB-MCP-Server"
  },
  "homepage": "https://github.com/nickdesi/FFBB-MCP-Server#readme",
  "bugs": {
    "url": "https://github.com/nickdesi/FFBB-MCP-Server/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "basketball",
    "ffbb",
    "france",
    "sports",
    "copilot",
    "agent"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "ffbb-mcp",
        "label": "FFBB Basketball MCP Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "package:ls": "vsce ls --tree --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.3",
    "typescript": "^5.9.2"
  }
}
