# FFBB MCP Server — Configuration

## Mode de transport
# MCP_MODE=stdio        # stdio (défaut) | streamable-http

## HTTP
# HOST=0.0.0.0
# PORT=9123
# PUBLIC_URL=https://ffbb.desimone.fr
# ALLOWED_HOSTS=ffbb.desimone.fr,localhost   # Liste des hôtes autorisés (sécurité DNS Rebinding, obligatoire si ENABLE_DNS_PROTECTION=true)
# ALLOWED_ORIGINS=https://votre-client-mcp.com,http://localhost:3000   # Origines autorisées pour les requêtes CORS
# TRUSTED_PROXY_HOSTS=127.0.0.1

## Logs
# FFBB_LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

## Performance
# MAX_CONCURRENT_FFBB=8
# FFBB_MAX_CALENDAR_MATCHES=300
# FFBB_POULE_FETCH_CONCURRENCY=8
# FFBB_MCP_PRUNE_LIMIT=50

## Cache (TTL en secondes)
# FFBB_CACHE_TTL_LIVES=15
# FFBB_CACHE_TTL_ORGANISME=86400
# FFBB_CACHE_TTL_SEARCH=86400
# FFBB_CACHE_TTL_BILAN=1800
# FFBB_CACHE_TTL_CLASSEMENT=1800
# FFBB_CACHE_TTL_CALENDRIER=300
# FFBB_CACHE_TTL_POULE=5

## Cache persistant (SQLite) — accélère les démarrages à froid
# Activé par défaut ; mettre à 0 pour revenir à un cache purement mémoire.
# FFBB_SERVICE_CACHE_PERSIST=1
# FFBB_WARMUP_ORGANISMES=12345,67890   # organismes préchargés au démarrage (mode HTTP)
# FFBB_WARMUP_CONCURRENCY=5            # limite de concurrence du préchauffage
# FFBB_WARMUP_MAX_ORGANISMES=50        # borne max d'organismes par préchauffage (anti-DoS)
# FFBB_WARMUP_API_KEY=                 # si définie, obligatoire sur POST /cache/warmup (Bearer)

## Stale-While-Revalidate — sert le cache et rafraîchit en arrière-plan
# Activé par défaut ; mettre à 0 pour désactiver.
# FFBB_SWR_ENABLED=1
# FFBB_SWR_STALE_FRACTION=0.75         # refresh quand l'entrée dépasse 75% de son TTL
# FFBB_LIVES_REFRESH_INTERVAL=10       # refresh proactif des lives toutes les N s (mode HTTP)

## Sécurité
# ENABLE_DNS_PROTECTION=true   # Activer la protection contre le DNS Rebinding en production
# FFBB_ENABLE_BENCHMARK=false

